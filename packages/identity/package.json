{
  "name": "@character-foundry/identity",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Versioned portable card identity and revision lineage primitives",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": {
    "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
  } },
  "files": ["dist"],
  "scripts": { "build": "tsup", "test": "vitest run", "typecheck": "tsc --noEmit" },
  "devDependencies": { "tsup": "^8.5.1", "typescript": "^5.3.0", "vitest": "4.1.11" },
  "engines": { "node": ">=20.9.0" },
  "license": "MIT"
}
